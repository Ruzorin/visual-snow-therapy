<Window x:Class="VisualSnowScreen.UI.NortTherapyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NORT - Neuro-Optometric Rehabilitation"
        WindowState="Maximized" 
        WindowStyle="None"
        Topmost="True"
        Background="#000000"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        Cursor="None">
    <!-- Cursor="None" hides the mouse cursor to prevent distraction -->
    <Grid>
        <!-- The actual drawing canvas for eyes -->
        <Canvas x:Name="ExerciseCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            
            <!-- Smooth Pursuit (Figure-8) Path Geometry used for animation (invisible, just for logic) -->
            <Path x:Name="Figure8Path" Stroke="Transparent" StrokeThickness="0">
                <Path.Data>
                    <!-- A wide figure 8 path centered on screen, we'll draw this properly in code-behind or specify a wide one here -->
                    <PathGeometry>
                        <PathFigure StartPoint="960,540">
                            <!-- Approximate Figure 8 using Beziers -->
                            <BezierSegment Point1="1360,140" Point2="1760,940" Point3="960,540"/>
                            <BezierSegment Point1="160,140"  Point2="560,940"  Point3="960,540"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>

            <!-- The Target Dot (used for both Saccades and Smooth Pursuit) -->
            <Ellipse x:Name="TargetDot" Width="40" Height="40" Fill="#F5C2E7" Visibility="Collapsed" Canvas.Left="-100" Canvas.Top="-100">
                <!-- Inner high-contrast dot for fixation precision -->
                <Ellipse.OpacityMask>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                        <GradientStop Color="#FFFFFFFF" Offset="0.8"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.OpacityMask>
            </Ellipse>
            
            <!-- Fixation dot in center -->
            <Ellipse x:Name="CenterFixation" Width="12" Height="12" Fill="#FFFFFF" Visibility="Collapsed" Canvas.Left="-100" Canvas.Top="-100"/>
        </Canvas>

        <!-- Information overlay (Fades out after start, fades in on finish) -->
        <Border x:Name="InfoOverlay" Background="#E61E1E2E" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40" CornerRadius="16">
            <StackPanel MinWidth="400">
                <TextBlock x:Name="TxtTitle" Text="Neuro-Optometric Rehabilitation Therapy" FontSize="20" FontWeight="SemiBold" Foreground="#F5C2E7" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock x:Name="TxtDesc" Text="NORT Session" TextWrapping="Wrap" FontSize="14" Foreground="#CDD6F4" TextAlignment="Center" Margin="0,0,0,24"/>
                
                <TextBlock x:Name="TxtTimeLeft" Text="Time Left:" FontSize="16" FontWeight="Bold" Foreground="#A6ADC8" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtTimer" Text="03:00" FontSize="48" FontWeight="Bold" Foreground="#A6E3A1" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                
                <TextBlock x:Name="TxtAutoClose" Text="Exercises will stop automatically." FontSize="12" Foreground="#585B70" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtEsc" Text="Press ESC to close." FontSize="12" Foreground="#F38BA8" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>