<Window x:Class="VisualSnowScreen.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visual Snow FL-41"
        Width="680" Height="760"
        MinWidth="560" MinHeight="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        ShowInTaskbar="True"
        Topmost="True"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="checkBoxBorder" Width="26" Height="26" CornerRadius="5"
                                    Background="#313244" BorderBrush="#45475A" BorderThickness="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="checkMark" Text="✓" FontSize="18" FontWeight="Bold"
                                           Foreground="#A6E3A1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#A6E3A1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#CBA6F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="PresetBtn" TargetType="Button">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Padding" Value="14,10,14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Background" Value="#CBA6F7"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F5C2E7"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="BackBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#585B70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ===== SETTINGS PANEL ===== -->
        <ScrollViewer x:Name="SettingsPanel" VerticalScrollBarVisibility="Auto" Padding="0">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Başlık -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock x:Name="LblTitle" Text="Visual Snow FL-41 Filter" FontSize="22" FontWeight="SemiBold" Foreground="#F5C2E7"/>
                    <TextBlock x:Name="LblSubtitle" Text="480-520nm blue-green block · rose-amber" FontSize="12" Foreground="#A6ADC8" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Filtre aktif -->
                <CheckBox Grid.Row="1" x:Name="ChkEnabled" Content="Filter ACTIVE" IsChecked="{Binding Enabled}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,20"/>

                <!-- Render Modu -->
                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <TextBlock x:Name="LblRenderMode" Style="{StaticResource SectionHeader}" Text="Render Mode"/>
                    <RadioButton x:Name="RbOverlay" GroupName="Mode" Checked="Overlay_Checked"/>
                    <RadioButton x:Name="RbGamma" GroupName="Mode" Checked="Gamma_Checked"/>
                </StackPanel>

                <!-- FL-41 Preset -->
                <StackPanel Grid.Row="3" Margin="0,0,0,20">
                    <TextBlock x:Name="LblPreset" Style="{StaticResource SectionHeader}" Text="FL-41 Color Preset"/>
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PresetBtn}" Tag="{Binding Hex}" Click="Preset_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="28" Height="28" Margin="0,0,14,0" RadiusX="5" RadiusY="5">
                                            <Rectangle.Fill>
                                                <SolidColorBrush Color="{Binding Color}"/>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#A6ADC8" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Opaklık (Overlay modu) -->
                <StackPanel Grid.Row="4" x:Name="PanelOpacity" Margin="0,0,0,20" IsEnabled="{Binding IsOverlayMode}">
                    <TextBlock x:Name="LblOpacity" Style="{StaticResource SectionHeader}" Text="Opacity"/>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="0%" DockPanel.Dock="Left" Foreground="#585B70" FontSize="11"/>
                        <TextBlock Text="100%" DockPanel.Dock="Right" Foreground="#585B70" FontSize="11" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Slider Minimum="0" Maximum="255" Value="{Binding Opacity}" TickFrequency="16" SmallChange="1" LargeChange="16"/>
                    <TextBlock Text="{Binding OpacityPercent, StringFormat=Current: {0}%}" Foreground="#F5C2E7" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Gamma Yoğunluğu (Gamma modu) -->
                <StackPanel Grid.Row="5" x:Name="PanelGamma" Margin="0,0,0,20" IsEnabled="{Binding IsGammaMode}">
                    <TextBlock x:Name="LblGammaIntensity" Style="{StaticResource SectionHeader}" Text="Gamma Intensity"/>
                    <Slider Minimum="0" Maximum="1" Value="{Binding GammaIntensity}" TickFrequency="0.05" SmallChange="0.01" LargeChange="0.1"/>
                    <TextBlock Text="{Binding GammaPercent, StringFormat=Current: {0}%}" Foreground="#F5C2E7" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock x:Name="LblNightLightNote" Text="Note: Windows Night Light must be off." FontSize="11" Foreground="#A6ADC8" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Akıllı Ekran Filtresi (VSS) -->
                <StackPanel Grid.Row="6" Margin="0,0,0,8" IsEnabled="{Binding IsOverlayMode}">
                    <CheckBox x:Name="ChkSmartNoise" Content="Enable Smart Screen Filter (VSS Habituation)" IsChecked="{Binding SmartNoiseEnabled}" Margin="0,0,0,8"/>
                    <StackPanel Margin="30,0,0,12" IsEnabled="{Binding SmartNoiseEnabled}">
                        <TextBlock x:Name="LblSmartNoise" Style="{StaticResource SectionHeader}" Text="Noise Opacity (1-10%)"/>
                        <Slider Minimum="1" Maximum="10" Value="{Binding SmartNoiseOpacity}" TickFrequency="1" SmallChange="1" LargeChange="2"/>
                        <TextBlock Text="{Binding SmartNoiseOpacity, StringFormat=Current: {0}%}" Foreground="#F5C2E7" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock x:Name="LblSmartNoiseWarning" Text="* Disabled safely after 15 mins to prevent fatigue." FontSize="11" Foreground="#F38BA8" Margin="0,4,0,0"/>
                        <Border Background="#45475A" CornerRadius="6" Padding="10,8" Margin="0,8,0,0" BorderBrush="#F38BA8" BorderThickness="1">
                            <TextBlock x:Name="LblSmartNoiseMedicalWarning" TextWrapping="Wrap" FontSize="11" Foreground="#F38BA8" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- AutoStart -->
                <CheckBox Grid.Row="7" x:Name="ChkAutoStart" Content="Start automatically with Windows" IsChecked="{Binding AutoStart}" Margin="0,0,0,16"/>

                <!-- 20-20-20 zorunlu mod -->
                <CheckBox Grid.Row="8" x:Name="ChkForcedEyeBreak" Content="Force 20-20-20 eye break (blocking reminder)" IsChecked="{Binding ForcedEyeBreak}" Margin="0,0,0,20"/>

                <!-- Relief erişim butonu -->
                <Button Grid.Row="9" x:Name="BtnOpenRelief" Click="OpenRelief_Click" Margin="0,0,0,16"
                        HorizontalAlignment="Stretch" Padding="0,18" FontSize="17" FontWeight="Bold"
                        Background="#CBA6F7" Foreground="#1E1E2E" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🧘 " FontSize="22" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BtnReliefText" Text="OPEN RELIEF TOOLS" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Dil seçici -->
                <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
                    <TextBlock x:Name="LblLanguage" Text="Language:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                    <ComboBox x:Name="CmbLanguage" Width="140" Background="#313244" Foreground="#CDD6F4" FontSize="14" SelectionChanged="Language_Changed">
                        <ComboBoxItem Content="English" Tag="English"/>
                        <ComboBoxItem Content="Français" Tag="French"/>
                        <ComboBoxItem Content="Deutsch" Tag="German"/>
                        <ComboBoxItem Content="Türkçe" Tag="Turkish"/>
                        <ComboBoxItem Content="Español" Tag="Spanish"/>
                    </ComboBox>
                </StackPanel>

                <!-- Kısayollar -->
                <Border Grid.Row="11" Background="#313244" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="LblHotkeys" Style="{StaticResource SectionHeader}" Text="Hotkeys"/>
                        <TextBlock x:Name="LblHkToggle" Text="Ctrl+Alt+F  —  Toggle filter" FontSize="12" Margin="0,3,0,0"/>
                        <TextBlock x:Name="LblHkSettings" Text="Ctrl+Alt+O  —  Settings panel" FontSize="12" Margin="0,3,0,0"/>
                        <TextBlock x:Name="LblHkMode" Text="Ctrl+Alt+M  —  Switch mode" FontSize="12" Margin="0,3,0,0"/>
                        <TextBlock x:Name="LblHkRelief" Text="Ctrl+Alt+R  —  Relief tools" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Kapat -->
                <Button Grid.Row="12" x:Name="BtnClose" Content="Close" Padding="0,10" HorizontalAlignment="Stretch" Click="Close_Click"
                        Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A" FontSize="14"/>
            </Grid>
        </ScrollViewer>

        <!-- ===== RELIEF PANEL ===== -->
        <Grid x:Name="ReliefPanel" Visibility="Collapsed" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Relief başlık + Geri butonu -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <Button x:Name="BtnReliefBack" Style="{StaticResource BackBtn}" Content="← Geri" Click="ReliefBack_Click" DockPanel.Dock="Left"/>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtReliefHeaderTitle" Text="Rahatlama ve Farkındalık" FontSize="18" FontWeight="SemiBold" Foreground="#F5C2E7" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtReliefHeaderSubtitle" Text="Visual Snow Syndrome için kanıt destekli rahatlama teknikleri" FontSize="11" Foreground="#A6ADC8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Sekme seçici -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                <Button x:Name="BtnBreathing" Style="{StaticResource TabBtn}" Content="4-7-8 Nefes" Click="ReliefTab_Click" Tag="breath"/>
                <Button x:Name="BtnEyeBreak" Style="{StaticResource TabBtn}" Content="20-20-20 Göz Molası" Click="ReliefTab_Click" Tag="break"/>
                <Button x:Name="BtnNort" Style="{StaticResource TabBtn}" Content="NORT Egzersizi" Click="ReliefTab_Click" Tag="nort"/>
                <Button x:Name="BtnHabituation" Style="{StaticResource TabBtn}" Content="Alışma (Deneysel)" Click="ReliefTab_Click" Tag="habit"/>
                <Button x:Name="BtnInfo" Style="{StaticResource TabBtn}" Content="Bilgi" Click="ReliefTab_Click" Tag="info"/>
            </WrapPanel>

            <!-- İçerik alanı -->
            <Border Grid.Row="2" Background="#313244" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <!-- 4-7-8 Nefes -->
                        <StackPanel x:Name="PanelBreathing" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtBreathTitle" Text="4-7-8 Nefes Tekniği" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtBreathDesc" Text="Parasympatik sinir sistemini aktive eder, stresi ve fotofobiyi azaltır." FontSize="11" Foreground="#A6ADC8" TextAlignment="Center" Margin="0,0,0,16" TextWrapping="Wrap" MaxWidth="420"/>
                            <Grid Width="220" Height="220" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Ellipse x:Name="BreathCircle" Width="220" Height="220" Fill="#45475A" Stroke="#CBA6F7" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="BreathScale" ScaleX="0.6" ScaleY="0.6"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="BreathPhase" Text="Hazır" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#F5C2E7"/>
                                    <TextBlock x:Name="BreathCount" Text="" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#CDD6F4"/>
                                </StackPanel>
                            </Grid>
                            <Button x:Name="BtnBreathStart" Style="{StaticResource ActionBtn}" Content="Başlat (4 döngü)" Click="Breathing_Start" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtBreathHint" Text="4 sn nefes al → 7 sn tut → 8 sn ver" FontSize="11" Foreground="#A6ADC8" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>

                        <!-- 20-20-20 Göz Molası -->
                        <StackPanel x:Name="PanelEyeBreak" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="TxtBreakTitle" Text="20-20-20 Kuralı" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtBreakDesc" Text="Her 20 dakikada 20 sn boyunca 20 ft (6m) uzağa bak." FontSize="11" Foreground="#A6ADC8" TextAlignment="Center" Margin="0,0,0,16" TextWrapping="Wrap" MaxWidth="420"/>
                            <Grid Width="220" Height="220" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Ellipse Width="220" Height="220" Fill="#45475A" Stroke="#A6E3A1" StrokeThickness="2"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="BreakCountdown" Text="20" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#A6E3A1"/>
                                    <TextBlock x:Name="TxtBreakSeconds" Text="saniye" FontSize="12" HorizontalAlignment="Center" Foreground="#A6ADC8"/>
                                </StackPanel>
                            </Grid>
                            <Button x:Name="BtnBreakStart" Style="{StaticResource ActionBtn}" Content="Şimdi Göz Molası Ver" Click="EyeBreak_Start" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtBreakHint" Text="Uzağa bakarken gözlerini kırpma — sakin, yumuşak bakış." FontSize="11" Foreground="#A6ADC8" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>

                        <!-- NORT Therapy -->
                        <StackPanel x:Name="PanelNort" VerticalAlignment="Top" Visibility="Collapsed">
                            <TextBlock x:Name="TxtNortTitle" Text="NORT: Göz Takibi ve Sıçrama Egzersizleri" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtNortDesc1" TextWrapping="Wrap" FontSize="12" TextAlignment="Justify" Margin="0,0,0,12">
                                <Run Text="Neuro-Optometric Rehabilitation Therapy (NORT), Visual Snow Sendromundaki okülomotor yetersizlikleri hedefler. Göz takibi (Smooth Pursuit) ve sıçrama (Saccade) tekniklerini kullanarak beynin görsel verileri daha rahat işlemesini sağlar."/>
                                <LineBreak/><LineBreak/>
                                <Run Foreground="#A0A0A0" Text="Shidlofsky vd. tarafından gerçekleştirilen bağımsız ve VSI destekli çalışmalar okulomotor disfonksiyon düzeltmelerinin semptomlarda iyileşme sağlayabildiğini belirtmektedir." />
                            </TextBlock>
                            <TextBlock x:Name="TxtNortDesc2" TextWrapping="Wrap" FontSize="12" TextAlignment="Justify" Margin="0,0,0,16">
                                <Run Text="Bu egzersiz toplam 3 dakika sürecek (1.5 dk göz takibi + 1.5 dk sıçrama). Süre bitiminde nörolojik yorgunluk ('rebound') olmaması için güvenli şekilde kapanır."/>
                            </TextBlock>
                            <Button x:Name="BtnNortStart" Style="{StaticResource ActionBtn}" Content="NORT Egzersizini Başlat" Click="Nort_Start" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Habituation (deneysel) -->
                        <StackPanel x:Name="PanelHabituation" VerticalAlignment="Top" Visibility="Collapsed">
                            <TextBlock x:Name="TxtHabitTitle" Text="Alışma (Habituation) — Deneysel" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtHabitDesc" TextWrapping="Wrap" FontSize="12" TextAlignment="Justify" Margin="0,0,0,12">
                                <Run Text="Bazı hastalar, kontrollü şekilde statik benzeri uyarana kısa süre maruz kalarak beynin görsel hiperaktivitesinin azaldığını bildiriyor (nöroplastisite prensibi)."/>
                            </TextBlock>
                            <TextBlock x:Name="TxtHabitDuration" Text="Süre seç:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="Habit30" Content="30 sn" Margin="0,0,16,0" IsChecked="True"/>
                                <RadioButton x:Name="Habit60" Content="60 sn" Margin="0,0,16,0"/>
                                <RadioButton x:Name="Habit120" Content="2 dk" Margin="0,0,16,0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtHabitWarning" Text="Uyarı: Bu deneysel bir tekniktir. Rahatsızlık artarsa hemen durdurun." FontSize="10" Foreground="#F38BA8" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button x:Name="BtnHabitStart" Style="{StaticResource ActionBtn}" Content="Statik Ekranı Göster" Click="Habituation_Start" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Bilgi -->
                        <StackPanel x:Name="PanelInfo" VerticalAlignment="Top" Visibility="Collapsed">
                            <TextBlock x:Name="TxtInfoTitle" Text="Visual Snow Syndrome Hakkında" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtInfoDesc1" TextWrapping="Wrap" FontSize="12" TextAlignment="Justify" Margin="0,0,0,10">
                                <Run Text="VSS, tüm görme alanında sürekli 'kar' veya statik görme ile karakterize nörolojik bir durumdur. Gözler açık veya kapalı fark etmez — 7/24 vardır."/>
                            </TextBlock>
                            <TextBlock x:Name="TxtInfoDesc2" TextWrapping="Wrap" FontSize="12" TextAlignment="Justify" Margin="0,0,0,10">
                                <Run Text="Eşlik eden semptomlar: palinopsi (artık görüntüler), fotofobi (ışık hassasiyeti), entoptik fenomenler, noktalı gece körlüğü, tinnitus."/>
                            </TextBlock>
                            <TextBlock x:Name="TxtInfoFl41Title" Text="Fotofobi için FL-41" FontSize="13" FontWeight="SemiBold" Foreground="#F5C2E7" Margin="0,4,0,4"/>
                            <TextBlock x:Name="TxtInfoFl41Desc" TextWrapping="Wrap" FontSize="12" TextAlignment="Justify" Margin="0,0,0,10">
                                <Run Text="FL-41 rose-amber camlar 480-520nm mavi-yeşil ışığı bloke eder. Klinik araştırmalar fotofobi yollarındaki (S1, S2, insula, ACC) beyin aktivasyonunu anlamlı ölçüde azalttığını gösteriyor. Bu uygulama aynı etkiyi ekran katmanı olarak taklit eder."/>
                            </TextBlock>
                            <TextBlock x:Name="TxtInfoTipsTitle" Text="Günlük Yönetim İpuçları" FontSize="13" FontWeight="SemiBold" Foreground="#F5C2E7" Margin="0,4,0,4"/>
                            <TextBlock x:Name="TxtInfoTips" TextWrapping="Wrap" FontSize="12" TextAlignment="Justify">
                                <Run Text="• Düzenli uyku (melatonin döngüsü)&#x0a;• Stres yönetimi: meditasyon, derin nefes&#x0a;• Kafein/alkol tüketimini azalt&#x0a;• Migren komorbiditesini tedavi et&#x0a;• FL-41 camlar + ekran filtresi (bu app)&#x0a;• 20-20-20 kuralı ile düzenli göz molası&#x0a;• Yüksek kontrast/strobe ışıktan kaçın"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Alt bilgi + kaynak linkleri -->
            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                <TextBlock x:Name="TxtSourceTitle" Text="Kaynaklar (resmi araştırma):" FontSize="9" FontWeight="SemiBold" Foreground="#585B70" HorizontalAlignment="Center"/>
                <TextBlock FontSize="9" Foreground="#585B70" TextAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap">
                    <Hyperlink NavigateUri="https://www.visualsnowinitiative.org/vss-tips" RequestNavigate="Link_Click" Foreground="#74C7EC">Visual Snow Initiative</Hyperlink>
                    <Run Text=" · "/>
                    <Hyperlink NavigateUri="https://pmc.ncbi.nlm.nih.gov/articles/PMC10939838" RequestNavigate="Link_Click" Foreground="#74C7EC">FL-41 Study</Hyperlink>
                    <Run Text=" · "/>
                    <Hyperlink NavigateUri="https://pubmed.ncbi.nlm.nih.gov/36495147/" RequestNavigate="Link_Click" Foreground="#74C7EC">NORT Research</Hyperlink>
