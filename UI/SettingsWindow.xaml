<Window x:Class="VisualSnowScreen.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visual Snow FL-41 — Ayarlar"
        Width="380" Height="560"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        ShowInTaskbar="True"
        Topmost="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style x:Key="PresetBtn" TargetType="Button">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="10,8,10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Visual Snow FL-41 Filtresi" FontSize="18" FontWeight="SemiBold" Foreground="#F5C2E7"/>
            <TextBlock Text="480-520nm mavi-yeşil blokajı · rose-amber" FontSize="11" Foreground="#A6ADC8" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Filtre aktif -->
        <CheckBox Grid.Row="1" Content="Filtre AKTİF" IsChecked="{Binding Enabled}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <!-- Render Modu -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Render Modu" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <RadioButton Content="Overlay — hassas FL-41 renk + opaklık (iş/masaüstü)" IsChecked="{Binding IsOverlayMode}" GroupName="Mode"/>
            <RadioButton Content="Gamma — donanımsal LUT, fullscreen oyun dostu" IsChecked="{Binding IsGammaMode}" GroupName="Mode"/>
        </StackPanel>

        <!-- FL-41 Preset -->
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="FL-41 Renk Preset" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ItemsControl ItemsSource="{Binding Presets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource PresetBtn}" Tag="{Binding Hex}" Click="Preset_Click">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="22" Height="22" Margin="0,0,10,0" RadiusX="4" RadiusY="4">
                                    <Rectangle.Fill>
                                        <SolidColorBrush Color="{Binding Color}"/>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#A6ADC8"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Opaklık (Overlay modu) -->
        <StackPanel Grid.Row="4" Margin="0,0,0,12" IsEnabled="{Binding IsOverlayMode}">
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Opaklık" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding OpacityPercent, StringFormat={}{0}%}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#F5C2E7"/>
            </DockPanel>
            <Slider Minimum="0" Maximum="255" Value="{Binding Opacity}" TickFrequency="16" IsSnapToTickEnabled="False" SmallChange="1" LargeChange="16"/>
        </StackPanel>

        <!-- Gamma Yoğunluğu (Gamma modu) -->
        <StackPanel Grid.Row="5" Margin="0,0,0,12" IsEnabled="{Binding IsGammaMode}">
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Gamma Yoğunluğu" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding GammaPercent, StringFormat={}{0}%}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#F5C2E7"/>
            </DockPanel>
            <Slider Minimum="0" Maximum="1" Value="{Binding GammaIntensity}" TickFrequency="0.05" SmallChange="0.01" LargeChange="0.1"/>
            <TextBlock Text="Not: Windows Night Light kapalı olmalı." FontSize="10" Foreground="#A6ADC8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- AutoStart -->
        <CheckBox Grid.Row="6" Content="Windows açılışında otomatik başlat" IsChecked="{Binding AutoStart}" Margin="0,0,0,12"/>

        <!-- Kısayollar -->
        <Border Grid.Row="7" Background="#313244" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Kısayollar" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="Ctrl+Alt+F  —  Filtre aç/kapa" FontSize="11" Margin="0,2,0,0"/>
                <TextBlock Text="Ctrl+Alt+O  —  Ayarlar paneli" FontSize="11" Margin="0,2,0,0"/>
                <TextBlock Text="Ctrl+Alt+M  —  Mod değiştir" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Kapat -->
        <Button Grid.Row="8" Content="Kapat" Padding="0,8" HorizontalAlignment="Stretch" Click="Close_Click"
                Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"/>
    </Grid>
</Window>