<Window x:Class="VisualSnowScreen.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visual Snow FL-41"
        Width="380" Height="640"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        ShowInTaskbar="True"
        Topmost="True"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style x:Key="PresetBtn" TargetType="Button">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="10,8,10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="Background" Value="#CBA6F7"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="LblTitle" Text="Visual Snow FL-41 Filter" FontSize="18" FontWeight="SemiBold" Foreground="#F5C2E7"/>
            <TextBlock x:Name="LblSubtitle" Text="480-520nm blue-green block · rose-amber" FontSize="11" Foreground="#A6ADC8" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Filtre aktif -->
        <CheckBox Grid.Row="1" x:Name="ChkEnabled" Content="Filter ACTIVE" IsChecked="{Binding Enabled}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <!-- Render Modu -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock x:Name="LblRenderMode" Text="Render Mode" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <RadioButton x:Name="RbOverlay" GroupName="Mode" Checked="Overlay_Checked"/>
            <RadioButton x:Name="RbGamma" GroupName="Mode" Checked="Gamma_Checked"/>
        </StackPanel>

        <!-- FL-41 Preset -->
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock x:Name="LblPreset" Text="FL-41 Color Preset" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ItemsControl ItemsSource="{Binding Presets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource PresetBtn}" Tag="{Binding Hex}" Click="Preset_Click">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="22" Height="22" Margin="0,0,10,0" RadiusX="4" RadiusY="4">
                                    <Rectangle.Fill>
                                        <SolidColorBrush Color="{Binding Color}"/>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#A6ADC8"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Opaklık (Overlay modu) -->
        <StackPanel Grid.Row="4" x:Name="PanelOpacity" Margin="0,0,0,12" IsEnabled="{Binding IsOverlayMode}">
            <DockPanel Margin="0,0,0,4">
                <TextBlock x:Name="LblOpacity" Text="Opacity" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding OpacityPercent, StringFormat={}{0}%}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#F5C2E7"/>
            </DockPanel>
            <Slider Minimum="0" Maximum="255" Value="{Binding Opacity}" TickFrequency="16" SmallChange="1" LargeChange="16"/>
        </StackPanel>

        <!-- Gamma Yoğunluğu (Gamma modu) -->
        <StackPanel Grid.Row="5" x:Name="PanelGamma" Margin="0,0,0,12" IsEnabled="{Binding IsGammaMode}">
            <DockPanel Margin="0,0,0,4">
                <TextBlock x:Name="LblGammaIntensity" Text="Gamma Intensity" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding GammaPercent, StringFormat={}{0}%}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#F5C2E7"/>
            </DockPanel>
            <Slider Minimum="0" Maximum="1" Value="{Binding GammaIntensity}" TickFrequency="0.05" SmallChange="0.01" LargeChange="0.1"/>
            <TextBlock x:Name="LblNightLightNote" Text="Note: Windows Night Light must be off." FontSize="10" Foreground="#A6ADC8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- AutoStart -->
        <CheckBox Grid.Row="6" x:Name="ChkAutoStart" Content="Start automatically with Windows" IsChecked="{Binding AutoStart}" Margin="0,0,0,12"/>

        <!-- Relief erişim butonu + Dil seçici -->
        <DockPanel Grid.Row="7" Margin="0,0,0,12">
            <Button x:Name="BtnOpenRelief" Style="{StaticResource ActionBtn}" Content="Open relief tools" Click="OpenRelief_Click" DockPanel.Dock="Left" Width="180"/>
            <ComboBox x:Name="CmbLanguage" DockPanel.Dock="Right" HorizontalAlignment="Right" Width="140" Background="#313244" Foreground="#CDD6F4" SelectionChanged="Language_Changed">
                <ComboBoxItem Content="English" Tag="English"/>
                <ComboBoxItem Content="Français" Tag="French"/>
                <ComboBoxItem Content="Deutsch" Tag="German"/>
                <ComboBoxItem Content="Türkçe" Tag="Turkish"/>
            </ComboBox>
        </DockPanel>

        <!-- Kısayollar -->
        <Border Grid.Row="8" Background="#313244" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="LblHotkeys" Text="Hotkeys" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="LblHkToggle" Text="Ctrl+Alt+F  —  Toggle filter" FontSize="11" Margin="0,2,0,0"/>
                <TextBlock x:Name="LblHkSettings" Text="Ctrl+Alt+O  —  Settings panel" FontSize="11" Margin="0,2,0,0"/>
                <TextBlock x:Name="LblHkMode" Text="Ctrl+Alt+M  —  Switch mode" FontSize="11" Margin="0,2,0,0"/>
                <TextBlock x:Name="LblHkRelief" Text="Ctrl+Alt+R  —  Relief tools" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Kapat -->
        <Button Grid.Row="9" x:Name="BtnClose" Content="Close" Padding="0,8" HorizontalAlignment="Stretch" Click="Close_Click"
                Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"/>
    </Grid>
</Window>