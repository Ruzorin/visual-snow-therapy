<Window x:Class="VisualSnowScreen.UI.ReliefWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visual Snow — Rahatlama ve Farkındalık"
        Width="520" Height="640"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        ShowInTaskbar="True"
        Topmost="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Background" Value="#CBA6F7"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Rahatlama ve Farkındalık" FontSize="18" FontWeight="SemiBold" Foreground="#F5C2E7"/>
            <TextBlock Text="Visual Snow Syndrome için kanıt destekli rahatlama teknikleri" FontSize="11" Foreground="#A6ADC8" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Sekme seçici -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnBreathing" Style="{StaticResource TabBtn}" Content="4-7-8 Nefes" Click="Tab_Click" Tag="breath"/>
            <Button x:Name="BtnEyeBreak" Style="{StaticResource TabBtn}" Content="20-20-20 Göz Molası" Click="Tab_Click" Tag="break"/>
            <Button x:Name="BtnHabituation" Style="{StaticResource TabBtn}" Content="Alışma (Deneysel)" Click="Tab_Click" Tag="habit"/>
            <Button x:Name="BtnInfo" Style="{StaticResource TabBtn}" Content="Bilgi" Click="Tab_Click" Tag="info"/>
        </StackPanel>

        <!-- İçerik alanı -->
        <Border Grid.Row="2" Background="#313244" CornerRadius="8" Padding="16">
            <Grid>
                <!-- 4-7-8 Nefes -->
                <StackPanel x:Name="PanelBreathing" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="4-7-8 Nefes Tekniği" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Parasympatik sinir sistemini aktive eder, stresi ve fotofobiyi azaltır." FontSize="11" Foreground="#A6ADC8" TextAlignment="Center" Margin="0,0,0,16" TextWrapping="Wrap" MaxWidth="380"/>

                    <!-- Nefes dairesi -->
                    <Grid Width="220" Height="220" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Ellipse x:Name="BreathCircle" Width="220" Height="220" Fill="#45475A" Stroke="#CBA6F7" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="BreathScale" ScaleX="0.6" ScaleY="0.6"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="BreathPhase" Text="Hazır" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#F5C2E7"/>
                            <TextBlock x:Name="BreathCount" Text="" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#CDD6F4"/>
                        </StackPanel>
                    </Grid>

                    <Button Style="{StaticResource ActionBtn}" Content="Başlat (4 döngü)" Click="Breathing_Start" HorizontalAlignment="Center"/>
                    <TextBlock Text="4 sn nefes al → 7 sn tut → 8 sn ver" FontSize="11" Foreground="#A6ADC8" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- 20-20-20 Göz Molası -->
                <StackPanel x:Name="PanelEyeBreak" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="20-20-20 Kuralı" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Her 20 dakikada 20 sn boyunca 20 ft (6m) uzağa bak." FontSize="11" Foreground="#A6ADC8" TextAlignment="Center" Margin="0,0,0,16" TextWrapping="Wrap" MaxWidth="380"/>

                    <Grid Width="220" Height="220" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Ellipse Width="220" Height="220" Fill="#45475A" Stroke="#A6E3A1" StrokeThickness="2"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="BreakCountdown" Text="20" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#A6E3A1"/>
                            <TextBlock Text="saniye" FontSize="12" HorizontalAlignment="Center" Foreground="#A6ADC8"/>
                        </StackPanel>
                    </Grid>

                    <Button Style="{StaticResource ActionBtn}" Content="Şimdi Göz Molası Ver" Click="EyeBreak_Start" HorizontalAlignment="Center"/>
                    <TextBlock Text="Uzağa bakarken gözlerini kırpma — sakin, yumuşak bakış." FontSize="11" Foreground="#A6ADC8" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Habituation (deneysel) -->
                <StackPanel x:Name="PanelHabituation" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock Text="Alışma (Habituation) — Deneysel" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" TextAlignment="Justify" Margin="0,0,0,12">
                        <Run Text="Bazı hastalar, kontrollü şekilde statik benzeri uyarana kısa süre maruz kalarak beynin görsel hiperaktivitesinin azaldığını bildiriyor (nöroplastisite prensibi)."/>
                    </TextBlock>

                    <TextBlock Text="Süre seç:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="Habit30" Content="30 sn" Margin="0,0,16,0" IsChecked="True"/>
                        <RadioButton x:Name="Habit60" Content="60 sn" Margin="0,0,16,0"/>
                        <RadioButton x:Name="Habit120" Content="2 dk" Margin="0,0,16,0"/>
                    </StackPanel>

                    <TextBlock Text="Uyarı: Bu deneysel bir tekniktir. Rahatsızlık artarsa hemen durdurun." FontSize="10" Foreground="#F38BA8" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Button Style="{StaticResource ActionBtn}" Content="Statik Ekranı Göster" Click="Habituation_Start" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Bilgi -->
                <StackPanel x:Name="PanelInfo" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock Text="Visual Snow Syndrome Hakkında" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" TextAlignment="Justify" Margin="0,0,0,10">
                        <Run Text="VSS, tüm görme alanında sürekli 'kar' veya statik görme ile karakterize nörolojik bir durumdur. Gözler açık veya kapalı fark etmez — 7/24 vardır."/>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="12" TextAlignment="Justify" Margin="0,0,0,10">
                        <Run Text="Eşlik eden semptomlar: palinopsi (artık görüntüler), fotofobi (ışık hassasiyeti), entoptik fenomenler, noktalı gece körlüğü, tinnitus."/>
                    </TextBlock>
                    <TextBlock Text="Fotofobi için FL-41" FontSize="13" FontWeight="SemiBold" Foreground="#F5C2E7" Margin="0,4,0,4"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" TextAlignment="Justify" Margin="0,0,0,10">
                        <Run Text="FL-41 rose-amber camlar 480-520nm mavi-yeşil ışığı bloke eder. Klinik araştırmalar fotofobi yollarındaki (S1, S2, insula, ACC) beyin aktivasyonunu anlamlı ölçüde azalttığını gösteriyor. Bu uygulama aynı etkiyi ekran katmanı olarak taklit eder."/>
                    </TextBlock>
                    <TextBlock Text="Günlük Yönetim İpuçları" FontSize="13" FontWeight="SemiBold" Foreground="#F5C2E7" Margin="0,4,0,4"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" TextAlignment="Justify">
                        <Run Text="• Düzenli uyku (melatonin döngüsü)&#x0a;• Stres yönetimi: meditasyon, derin nefes&#x0a;• Kafein/alkol tüketimini azalt&#x0a;• Migren komorbiditesini tedavi et&#x0a;• FL-41 camlar + ekran filtresi (bu app)&#x0a;• 20-20-20 kuralı ile düzenli göz molası&#x0a;• Yüksek kontrast/strobe ışıktan kaçın"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Alt bilgi + kaynak linkleri -->
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="Kaynaklar (resmi araştırma):" FontSize="9" FontWeight="SemiBold" Foreground="#585B70" HorizontalAlignment="Center"/>
            <TextBlock FontSize="9" Foreground="#585B70" TextAlignment="Center" Margin="0,2,0,0">
                <Hyperlink NavigateUri="https://www.visualsnowinitiative.org/vss-tips" RequestNavigate="Link_Click" Foreground="#74C7EC">Visual Snow Initiative — Yönetim İpuçları</Hyperlink>
                <Run Text=" · "/>
                <Hyperlink NavigateUri="https://pmc.ncbi.nlm.nih.gov/articles/PMC10939838" RequestNavigate="Link_Click" Foreground="#74C7EC">FL-41 Nöral Çalışma (PMC)</Hyperlink>
            </TextBlock>
            <TextBlock FontSize="9" Foreground="#585B70" TextAlignment="Center" Margin="0,2,0,0">
                <Hyperlink NavigateUri="https://pmc.ncbi.nlm.nih.gov/articles/PMC11930237" RequestNavigate="Link_Click" Foreground="#74C7EC">Filtreli Camlar VSS Çalışması (PMC)</Hyperlink>
                <Run Text=" · "/>
                <Hyperlink NavigateUri="https://eyewiki.org/Visual_Snow" RequestNavigate="Link_Click" Foreground="#74C7EC">EyeWiki — Visual Snow</Hyperlink>
            </TextBlock>
            <TextBlock Text="Tıbbi tavsiye yerine geçmez. Semptomlar için nöro-oftalmoloğa başvurun." FontSize="8" Foreground="#45475A" TextAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</Window>