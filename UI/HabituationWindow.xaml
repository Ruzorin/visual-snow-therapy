<Window x:Class="VisualSnowScreen.UI.HabituationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Habituation — Deneysel"
        Width="500" Height="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#0D0D1A"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">
    <Grid>
        <!-- Statik benzeri arka plan: küçük beyaz noktalar (Canvas ile programmatik de değil, XAML grid) -->
        <Canvas x:Name="StaticCanvas" Background="#0D0D1A"/>

        <!-- Üst bilgi -->
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0">
            <TextBlock x:Name="PhaseText" Text="Kontrollü maruziyet — sakin bak" FontSize="16" FontWeight="SemiBold" Foreground="#CDD6F4" HorizontalAlignment="Center"/>
            <TextBlock Text="ESC ile kapat. Rahatsızlık artarsa hemen durdur." FontSize="10" Foreground="#F38BA8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Geri sayım -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="RemainingText" Text="30" FontSize="72" FontWeight="Bold" Foreground="#89B4FA" HorizontalAlignment="Center"/>
            <TextBlock Text="saniye" FontSize="14" Foreground="#A6ADC8" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Kapat -->
        <Button Content="Durdur" Width="100" Padding="0,8" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"
                Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A" Click="Close_Click"/>
    </Grid>
</Window>