<Window x:Class="VisualSnowScreen.UI.HabituationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Habituation — Deneysel"
        Width="600" Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#0D0D1A"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Üst bilgi -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,24,0,12">
            <TextBlock x:Name="PhaseText" Text="Kontrollü maruziyet — sakin bak" FontSize="18" FontWeight="SemiBold" Foreground="#CDD6F4" HorizontalAlignment="Center"/>
            <TextBlock Text="ESC ile kapat. Rahatsızlık artarsa hemen durdur." FontSize="11" Foreground="#F38BA8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Statik benzeri arka plan + geri sayım (aynı hücre, üst üste) -->
        <Grid Grid.Row="1">
            <Canvas x:Name="StaticCanvas" Background="#0D0D1A"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="RemainingText" Text="30" FontSize="80" FontWeight="Bold" Foreground="#89B4FA" HorizontalAlignment="Center"/>
                <TextBlock Text="saniye" FontSize="16" Foreground="#A6ADC8" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Kapat -->
        <Button Grid.Row="2" Content="Durdur" Width="140" Padding="0,10" HorizontalAlignment="Center" Margin="0,0,0,24"
                Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A" FontSize="14" Click="Close_Click"/>
    </Grid>
</Window>